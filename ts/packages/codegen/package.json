{
  "name": "@clamator/codegen",
  "version": "0.1.8",
  "description": "Codegen CLI: Zod contracts → TS + Py wrappers (pre-1.0).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "clamator-codegen": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clamator/protocol": "workspace:*",
    "commander": "^12.1.0",
    "tsx": "^4.19.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "homepage": "https://github.com/deai-network/clamator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deai-network/clamator.git",
    "directory": "ts/packages/codegen"
  },
  "bugs": {
    "url": "https://github.com/deai-network/clamator/issues"
  },
  "author": "Kristof Csillag"
}
